APP_NAME=Invora
APP_TAGLINE="Predict - Optimize - Replenish"
APP_ENV=local
COMPOSE_PROJECT_NAME=invora
# Compose defaults below preserve the normal local stack. Override all of them
# for an isolated disposable stack; INVORA_ENV_FILE controls service env_file.
# INVORA_ENV_FILE=.live.env
# BACKEND_CONTAINER_NAME=invora-backend
# MIGRATE_CONTAINER_NAME=invora-migrate
# WORKER_CONTAINER_NAME=invora-worker
# POSTGRES_CONTAINER_NAME=invora-postgres
# REDIS_CONTAINER_NAME=invora-redis
# POSTGRES_VOLUME_NAME=invora-postgres-data
# REDIS_VOLUME_NAME=invora-redis-data
# INVORA_NETWORK_NAME=invora-network
DEBUG=true
API_V1_PREFIX=/api/v1
API_HOST=127.0.0.1
API_PORT=8000
# Production fails if its configured port cannot be bound. Keep this false
# outside explicitly local development sessions.
API_PORT_FALLBACK_ENABLED=false
POSTGRES_HOST_PORT=5432
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_DB=invora
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:${POSTGRES_HOST_PORT}/invora
# Prisma Postgres URLs may retain their required sslmode query parameter. The
# backend translates it to asyncpg's SSL option and Alembic uses the documented
# direct endpoint when DATABASE_URL targets pooled.db.prisma.io.
DOCKER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@invora-postgres:5432/invora
REDIS_URL=redis://localhost:56379/0
DOCKER_REDIS_URL=redis://invora-redis:6379/0
RQ_DEFAULT_QUEUE=invora-default
RQ_FORECAST_QUEUE=invora-forecasting
RQ_JOB_TIMEOUT_SECONDS=1800
RQ_MAX_RETRIES=3
RQ_RETRY_INTERVAL_SECONDS=30
RQ_RESULT_TTL_SECONDS=86400
RQ_FAILURE_TTL_SECONDS=604800
RQ_WORKER_NAME_PREFIX=invora-worker
# RQ refreshes its worker heartbeat before each dequeue wait. This short TTL
# bounds how long a forcibly stopped worker can remain readiness-eligible.
RQ_WORKER_TTL_SECONDS=60
WORKER_ENABLED=true
# Keep false locally: Docker Compose runs invora-worker as the dedicated RQ
# worker service. Set true only for a deployment that intentionally embeds the
# existing worker alongside the API in one container.
RUN_EMBEDDED_WORKER=false
REDIS_HOST_PORT=56379
REDIS_HOST_BIND=127.0.0.1
BACKEND_HOST_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Authentication abuse controls use Redis and are required in production. The
# IP value is derived from the trusted ASGI client address, not raw X-Forwarded-For.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=20
AUTH_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=10
AUTH_REGISTER_MAX_ATTEMPTS_PER_IP=5
AUTH_REFRESH_MAX_ATTEMPTS_PER_IP=30
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Host-only HttpOnly cookie used only for refresh and logout. In production,
# Secure is enforced. Keep SameSite=lax for same-site frontend/API deployments;
# use none only for a deliberate HTTPS cross-site deployment.
REFRESH_COOKIE_NAME=invora_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=
