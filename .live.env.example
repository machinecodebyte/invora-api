# Disposable, isolated integration-stack configuration. Copy this file to
# .live.env, replace the placeholder values, and never use these names or
# ports for the normal local development stack.
APP_NAME=Invora
APP_TAGLINE="Predict - Optimize - Replenish"
APP_ENV=test
DEBUG=false
API_V1_PREFIX=/api/v1
API_HOST=127.0.0.1
API_PORT=8000
API_PORT_FALLBACK_ENABLED=false

COMPOSE_PROJECT_NAME=invora-harden-live
INVORA_ENV_FILE=.live.env
BACKEND_CONTAINER_NAME=invora-harden-live-backend
MIGRATE_CONTAINER_NAME=invora-harden-live-migrate
WORKER_CONTAINER_NAME=invora-harden-live-worker
POSTGRES_CONTAINER_NAME=invora-harden-live-postgres
REDIS_CONTAINER_NAME=invora-harden-live-redis
POSTGRES_VOLUME_NAME=invora-harden-live-postgres-data
REDIS_VOLUME_NAME=invora-harden-live-redis-data
INVORA_NETWORK_NAME=invora-harden-live-network
BACKEND_HOST_PORT=18000
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379

POSTGRES_DB=invora_live
POSTGRES_USER=invora_live
POSTGRES_PASSWORD=replace-with-a-disposable-test-password
DATABASE_URL=postgresql+asyncpg://invora_live:replace-with-a-disposable-test-password@localhost:15432/invora_live
DOCKER_DATABASE_URL=postgresql+asyncpg://invora_live:replace-with-a-disposable-test-password@invora-postgres:5432/invora_live
REDIS_URL=redis://localhost:16379/0
DOCKER_REDIS_URL=redis://invora-redis:6379/0

RQ_DEFAULT_QUEUE=invora-default
RQ_FORECAST_QUEUE=invora-forecasting
RQ_JOB_TIMEOUT_SECONDS=1800
RQ_MAX_RETRIES=3
RQ_RETRY_INTERVAL_SECONDS=1
RQ_RESULT_TTL_SECONDS=86400
RQ_FAILURE_TTL_SECONDS=604800
RQ_WORKER_NAME_PREFIX=invora-live-worker
RQ_WORKER_TTL_SECONDS=30
WORKER_ENABLED=true

CORS_ORIGINS=http://localhost:3105
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace-with-a-long-disposable-test-secret
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=100
AUTH_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=100
AUTH_REGISTER_MAX_ATTEMPTS_PER_IP=100
AUTH_REFRESH_MAX_ATTEMPTS_PER_IP=100
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=invora_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
